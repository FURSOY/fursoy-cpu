# Fursoy CPU .gitignore
# ==============================================================================

# Rebuildable compilation and simulation outputs
build/
obj_dir/
tools/synth/bin/
tools/synth/lib/*.lib

# Logs
*.log

# Intermediate object and binary artifacts outside build/
*.o
*.a
*.so
*.dylib
*.elf
*.bin
*.hex
*.exe

# Waveforms and simulation traces
*.vcd
*.fst
*.vpd
*.wlf

# Python bytecode and virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
ENV/

# Editor and IDE metadata / swap files
.vscode/
.idea/
.gemini/
*.swp
*.swo
*~
*.bak
*.tmp

# OS-generated metadata
.DS_Store
Thumbs.db

# Scratch and transient working scripts
scratch/
