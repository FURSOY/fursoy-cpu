# Fursoy Slice-2/2.5 SMP Multi-Hart Linux Kernel Configuration (Linux 6.6.50)
# Target Architecture: RV64IMAFD_Zicsr_Zifencei (non-C, CONFIG_FPU=y), Sv39, SMP (2..4 Harts),
# SBI v2.0 (HSM/sPI/RFENCE/TIME/SRST/DBCN), CLINT, Multi-Context PLIC, 16550A UART

CONFIG_64BIT=y
CONFIG_ARCH_RV64I=y
CONFIG_NONPORTABLE=y
# CONFIG_RISCV_ISA_C is not set
CONFIG_FPU=y
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZBB is not set

CONFIG_SMP=y
CONFIG_NR_CPUS=4

CONFIG_MMU=y
CONFIG_PAGE_OFFSET=0xff60000000000000
CONFIG_CMODEL_MEDANY=y

CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_RISCV_TIMER=y
CONFIG_SIFIVE_PLIC=y

CONFIG_OF=y
CONFIG_OF_EARLY_FLATTREE=y

CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y

CONFIG_TTY=y
# CONFIG_VT is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_LEGACY_PTYS is not set
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1

CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="usr/initramfs_data.cpio"
CONFIG_INITRAMFS_ROOT_UID=0
CONFIG_INITRAMFS_ROOT_GID=0
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_INITRAMFS_COMPRESSION_GZIP is not set

CONFIG_FUTEX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_100=y

CONFIG_CMDLINE="console=ttyS0 earlycon=sbi root=/dev/ram0 rw rdinit=/init"
CONFIG_CMDLINE_FALLBACK=y

# Disable unused subsystems for deterministic minimal SMP build
# CONFIG_NET is not set
# CONFIG_PCI is not set
# CONFIG_MODULES is not set
# CONFIG_BLOCK is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_PM is not set
# CONFIG_EFI is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_INPUT is not set
# CONFIG_HID is not set
CONFIG_CRYPTO=y
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y

CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_SLUB=y
